{
  "name": "n8n-nodes-sabia",
  "version": "0.1.0",
  "description": "Create and update Sabia clients, and trigger n8n workflows from Sabia client events.",
  "license": "MIT",
  "homepage": "https://github.com/Sabia-de/n8n-nodes-sabia#readme",
  "keywords": ["n8n-community-node-package", "n8n", "sabia", "crm", "clients"],
  "author": { "name": "Silas Wolf", "email": "silas@silaswolf.com" },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sabia-de/n8n-nodes-sabia.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test tests/*.test.cjs",
    "scan": "npx @n8n/scan-community-package n8n-nodes-sabia",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/SabiaApi.credentials.js"],
    "nodes": ["dist/nodes/Sabia/Sabia.node.js", "dist/nodes/SabiaTrigger/SabiaTrigger.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "engines": { "node": ">=22.0.0" }
}
